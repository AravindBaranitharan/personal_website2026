# SMTP server host; leave empty to send through Gmail (service "gmail") with an app password
SMTP_HOST=smtp.example.com
# SMTP port; 465 uses TLS from the start, anything else (default 587) upgrades with STARTTLS
SMTP_PORT=587
# SMTP login username (falls back to EMAIL)
SMTP_USER=you@example.com
# SMTP password or Gmail app password (falls back to EMAIL_PASS)
SMTP_PASS=your-smtp-password
# Legacy alias for the sender/login address, used when SMTP_USER, CONTACT_FROM or CONTACT_TO are not set
EMAIL=
# Legacy alias for the SMTP password, used when SMTP_PASS is not set
EMAIL_PASS=
# "From" address on contact-form emails (defaults to EMAIL, then SMTP_USER)
CONTACT_FROM="Portfolio contact <you@example.com>"
# Inbox that receives contact-form messages (defaults to EMAIL, then SMTP_USER)
CONTACT_TO=you@example.com
